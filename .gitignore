# Runtime output
logs/
pcaps/
reports/
evidence/ids/*
evidence/logs/*
evidence/incident/*

# Keep evidence directories if users create them
!evidence/ids/
!evidence/ids/.gitkeep
!evidence/logs/
!evidence/logs/.gitkeep
!evidence/incident/
!evidence/incident/.gitkeep

# Python/cache/editor artifacts
__pycache__/
*.pyc
.DS_Store
*.swp
*.swo

# Local environment
.env
.env.*
.tools/

# Teacher-only files (never commit)
lab-passwords.txt
.teacher-config
.teacher-data/
.progress/

# Plaintext lab content — NOT committed (committed as .enc instead)
labs/*/steps/
labs/*/hints/
labs/*/checks/

# Encrypted marker files (transient, regenerated)
labs/*/.encrypted

# Student runtime
submit/
